# 复制为 config/local.properties（已被 .gitignore 排除），不要提交真实密钥。
# Spring 读取方式：spring.config.import=optional:file:./config/local.properties

# 演示只读数据源（本地 MySQL 8.4，账号仅有 SELECT 权限）
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/sql_demo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowMultiQueries=false
spring.datasource.username=demo_reader
spring.datasource.password=change-me

# OpenAI 兼容模型服务；留空时 /generate/stream 返回 MODEL_NOT_CONFIGURED
app.llm.base-url=https://api.deepseek.com/v1
app.llm.api-key=
app.llm.model=deepseek-chat
