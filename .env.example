# 复制为 config/local.properties（已被 .gitignore 排除），不要提交真实密钥。

# 可写管理库：用户、连接配置；与业务查询库分离
app.management.url=jdbc:mysql://127.0.0.1:3306/sql_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowMultiQueries=false
app.management.username=platform_app
app.management.password=change-me

# 32 字节随机密钥的 Base64；生成示例：openssl rand -base64 32
# 必须与数据库分开保管，不得提交
app.security.encryption-key=change-me-base64-32-bytes

# 允许被连接的目标主机/端口（防止任意 SSRF）
app.connection-policy.allowed-hosts=127.0.0.1,localhost
app.connection-policy.allowed-ports=3306,3307,3308,3309,3310

# OpenAI 兼容模型服务；留空时 /generate/stream 返回 MODEL_NOT_CONFIGURED
app.llm.base-url=https://api.deepseek.com/v1
app.llm.api-key=
app.llm.model=deepseek-chat

# OpenAI 兼容 Embedding 服务；默认可与 LLM 共用地址和密钥，也可单独配置
app.embedding.base-url=https://dashscope.aliyuncs.com/compatible-mode/v1
app.embedding.api-key=
app.embedding.model=qwen3.7-text-embedding-flash
app.embedding.dimensions=1024
