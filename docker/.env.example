# 复制为 docker/.env；docker/start.ps1 会在缺失时自动生成随机值。
MYSQL_ROOT_PASSWORD=replace-with-random-password
MYSQL_APP_PASSWORD=replace-with-random-password
DEMO_A_PASSWORD=replace-with-random-password
DEMO_B_PASSWORD=replace-with-random-password
POSTGRES_PASSWORD=replace-with-random-password

# 如本机端口被占用，可只改左侧宿主机端口。
FRONTEND_PORT=5174
GATEWAY_PORT=8080
SERVICE_PORT=8081
ADMIN_PORT=8083
NACOS_CONSOLE_PORT=8082
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_RAFT_PORT=9849
MYSQL_PORT=3306
REDIS_PORT=6379
POSTGRES_PORT=5432
